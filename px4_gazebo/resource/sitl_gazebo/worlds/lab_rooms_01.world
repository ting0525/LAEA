<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lab_rooms_01">
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 -0.2 -0.9</direction>
    </light>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.62 0.62 0.62 1</background>
      <shadows>1</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.16 0.16 0.18 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <!-- A 26 x 22 m floor plan. The central 8 x 4 m hall is the spawn-safe area. -->
    <model name="room_architecture">
      <static>true</static>
      <link name="north"><pose>0 11 1.5 0 0 0</pose><collision name="c"><geometry><box><size>26.5 0.35 3</size></box></geometry></collision><visual name="v"><geometry><box><size>26.5 0.35 3</size></box></geometry><material><diffuse>0.42 0.42 0.46 1</diffuse></material></visual></link>
      <link name="south"><pose>0 -11 1.5 0 0 0</pose><collision name="c"><geometry><box><size>26.5 0.35 3</size></box></geometry></collision><visual name="v"><geometry><box><size>26.5 0.35 3</size></box></geometry><material><diffuse>0.42 0.42 0.46 1</diffuse></material></visual></link>
      <link name="west"><pose>-13 0 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.35 22.5 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 22.5 3</size></box></geometry><material><diffuse>0.42 0.42 0.46 1</diffuse></material></visual></link>
      <link name="east"><pose>13 0 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.35 22.5 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 22.5 3</size></box></geometry><material><diffuse>0.42 0.42 0.46 1</diffuse></material></visual></link>
      <link name="left_upper_partition"><pose>-4.5 6.5 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.35 8 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 8 3</size></box></geometry><material><diffuse>0.25 0.60 0.40 1</diffuse></material></visual></link>
      <link name="left_lower_partition"><pose>-4.5 -6.5 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.35 8 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 8 3</size></box></geometry><material><diffuse>0.25 0.60 0.40 1</diffuse></material></visual></link>
      <link name="right_upper_partition"><pose>4.5 6.5 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.35 8 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 8 3</size></box></geometry><material><diffuse>0.25 0.60 0.40 1</diffuse></material></visual></link>
      <link name="right_lower_partition"><pose>4.5 -6.5 1.5 0 0 0</pose><collision name="c"><geometry><box><size>0.35 8 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 8 3</size></box></geometry><material><diffuse>0.25 0.60 0.40 1</diffuse></material></visual></link>
      <link name="north_room_divider"><pose>0 6.5 1.5 0 0 0</pose><collision name="c"><geometry><box><size>8.7 0.35 3</size></box></geometry></collision><visual name="v"><geometry><box><size>8.7 0.35 3</size></box></geometry><material><diffuse>0.25 0.60 0.40 1</diffuse></material></visual></link>
      <link name="south_room_divider"><pose>0 -6.5 1.5 0 0 0</pose><collision name="c"><geometry><box><size>8.7 0.35 3</size></box></geometry></collision><visual name="v"><geometry><box><size>8.7 0.35 3</size></box></geometry><material><diffuse>0.25 0.60 0.40 1</diffuse></material></visual></link>
      <link name="landmark_west"><pose>-9 0 1.2 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.65</radius><length>2.4</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.65</radius><length>2.4</length></cylinder></geometry><material><diffuse>0.78 0.32 0.25 1</diffuse></material></visual></link>
      <link name="landmark_east"><pose>9 0 1.2 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.65</radius><length>2.4</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.65</radius><length>2.4</length></cylinder></geometry><material><diffuse>0.78 0.32 0.25 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
