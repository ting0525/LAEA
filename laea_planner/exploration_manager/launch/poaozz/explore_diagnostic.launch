<launch>

  <!-- Diagnostic entrypoint for A/B testing.
       Default: upstream planner params + direct Gazebo depth.
       Current local behavior can be selected with:
       algorithm_file:=$(find exploration_manager)/launch/poaozz/algorithm_.xml
       depth_topic:=/rtp/depth/image_raw -->

  <arg name="algorithm_file" default="$(find exploration_manager)/launch/poaozz/algorithm_1.xml"/>
  <arg name="depth_topic" default="/camera/depth/image_raw"/>
  <arg name="cloud_topic" default="/pcl_render_node/cloud"/>
  <arg name="sensor_pose_topic" default="/mavros/camera/pose"/>

  <!-- for rviz visualization uav_pose -->
  <node pkg="tf" type="static_transform_publisher" name="tf_map2world_link"
        args="0 0 0 0 0 0 map world 30" />

  <!-- size of map, change the size in x, y, z according to your application -->
  <arg name="map_size_x" default="80.0"/>
  <arg name="map_size_y" default="80.0"/>
  <arg name="map_size_z" default="3.0"/>

  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="1.0"/>

  <!-- topic of your odometry such as VIO or LIO -->
  <arg name="odom_topic" default="/mavros/local_position/odom" />

  <!-- maximum velocity and acceleration the drone will reach -->
  <arg name="max_vel" default="1.0" />
  <arg name="max_acc" default="1" />

  <!-- indoor_01 -->
  <arg name="box_x_min" default="-23" />
  <arg name="box_y_min" default="-11" />
  <arg name="box_z_min" default="-0.1" />
  <arg name="box_x_max" default="23" />
  <arg name="box_y_max" default="11" />
  <arg name="box_z_max" default="2.3" />

  <!-- intrinsic params of the depth camera -->
  <arg name="cx" default="321.04638671875"/>
  <arg name="cy" default="243.44969177246094"/>
  <arg name="fx" default="387.229248046875"/>
  <arg name="fy" default="387.229248046875"/>

  <!-- main algorithm params -->
  <include file="$(arg algorithm_file)">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>

    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>

    <arg name="sensor_pose_topic" value="$(arg sensor_pose_topic)"/>
    <arg name="depth_topic" value="$(arg depth_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>

    <arg name="cx" value="$(arg cx)"/>
    <arg name="cy" value="$(arg cy)"/>
    <arg name="fx" value="$(arg fx)"/>
    <arg name="fy" value="$(arg fy)"/>

    <arg name="max_vel" value="$(arg max_vel)" />
    <arg name="max_acc" value="$(arg max_acc)" />

    <arg name="box_x_min" value="$(arg box_x_min)" />
    <arg name="box_y_min" value="$(arg box_y_min)" />
    <arg name="box_z_min" value="$(arg box_z_min)" />
    <arg name="box_x_max" value="$(arg box_x_max)" />
    <arg name="box_y_max" value="$(arg box_y_max)" />
    <arg name="box_z_max" value="$(arg box_z_max)" />
  </include>

  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger" />
    <param name="waypoint_type" value="point"/>
  </node>

</launch>
