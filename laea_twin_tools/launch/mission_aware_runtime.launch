<launch>
  <arg name="attack_profile" default="none"/>
  <arg name="attack_seed" default="42"/>
  <arg name="detector_name" default="rule_mad"/>
  <arg name="supervisor_policy" default="none"/>
  <arg name="depth_topic" default="/rtp/depth/image_raw"/>

  <node pkg="laea_twin_tools" type="attack_scheduler.py" name="attack_scheduler" output="screen">
    <rosparam command="load" file="$(find laea_twin_tools)/config/attack_profiles.yaml"/>
    <param name="profile" value="$(arg attack_profile)"/>
    <param name="seed" value="$(arg attack_seed)"/>
  </node>

  <!-- Relays the ROS attack command onto Gazebo transport for the source-layer
       sensor attack plugins (which build in the PX4 tree without roscpp). -->
  <node pkg="px4_gazebo" type="attack_gazebo_bridge" name="attack_gazebo_bridge" output="screen"/>

  <node pkg="laea_twin_tools" type="mission_state_node.py" name="mission_state_node" output="screen">
    <rosparam command="load" file="$(find laea_twin_tools)/config/mission_state.yaml"/>
    <param name="detector_name" value="$(arg detector_name)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
  </node>

  <node pkg="laea_twin_tools" type="supervisor_node.py" name="mission_supervisor" output="screen">
    <rosparam command="load" file="$(find laea_twin_tools)/config/mission_state.yaml"/>
    <param name="policy" value="$(arg supervisor_policy)"/>
  </node>

  <!-- Turns supervisor HOVER (auto or dashboard override) into a planner pause. -->
  <node pkg="laea_twin_tools" type="feedback_actuator.py" name="feedback_actuator" output="screen"/>
</launch>
